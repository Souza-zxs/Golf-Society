# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Nome do bucket do Supabase Storage usado pela galeria de fotos
SUPABASE_GALLERY_BUCKET=gallery

# Chave usada pelos endpoints administrativos (criar/editar/remover posts,
# eventos, revisar candidaturas etc). Enviar como header:
# Authorization: Bearer <ADMIN_API_KEY>
ADMIN_API_KEY=change-me

# Origem(ns) do front-end autorizadas para CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000

PORT=3333
NODE_ENV=development

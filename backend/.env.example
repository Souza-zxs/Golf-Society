# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Nome do bucket do Supabase Storage usado pela galeria de fotos
SUPABASE_GALLERY_BUCKET=gallery

# Origem(ns) do front-end autorizadas para CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000

PORT=3333
NODE_ENV=development

# Resend (envio de e-mail transacional)
# https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Remetente. Use um endereço do seu domínio verificado no Resend em produção;
# "onboarding@resend.dev" só funciona para testes.
EMAIL_FROM=Sellers Society Golf <onboarding@resend.dev>
# Opcional: endereço para onde vão as respostas de "Responder" do destinatário
# (útil se o EMAIL_FROM for um endereço de no-reply/institucional)
EMAIL_REPLY_TO=
